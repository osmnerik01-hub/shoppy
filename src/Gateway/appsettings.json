{
 "ReverseProxy": {
  "Routes": {
   "products": { "ClusterId": "catalog", "Match": { "Path": "/api/products/{**rest}" }, "Transforms": [{ "PathRemovePrefix": "/api" }] },
   "orders": { "ClusterId": "orders", "Match": { "Path": "/api/orders/{**rest}" }, "Transforms": [{ "PathRemovePrefix": "/api" }] }
  },
  "Clusters": {
   "catalog": { "Destinations": { "primary": { "Address": "http://localhost:5101/" } }, "HttpRequest": { "ActivityTimeout": "00:00:05" } },
   "orders": { "Destinations": { "primary": { "Address": "http://localhost:5103/" } }, "HttpRequest": { "ActivityTimeout": "00:00:05" } }
  }
 }
}
